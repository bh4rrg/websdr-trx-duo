fpga/OpenZynqSDR_HW-main/Src_Vivado/OpenZynqSDR_HW.ip_user_files/
src/red-pitaya-notes-web888_bootloader_si5351_driver/tmp/

# ---- CMake/zig 构建输出 ----
fpga/build_app/build/
fpga/build_app/zig-cache-local/
fpga/build_app/*.log
fpga/build_app/t*.elf

# ---- 上游源码树自带的音频样本（30MB+，非我们产出）----
**/kiwi.config/samples/
**/config/samples/
unix_env/kiwi.config/

# ---- 上游重复副本（develop 版才是我们在改的）----
/fpga/OpenZynqSDRApp/
/fpga/TRX_DUO_125-16-master/

# ---- Vivado IP 生成物 ----
ipshared/
*.xi
*.mmcn
ip_user_files/
*.ip_user_files/

# ---- 上游自带音频样本 ----
**/standalone_test/*.au
*.au
*.raw

# ---- 杂项 ----
-
com6-raw.bin
*.tmp
Thumbs.db
Desktop.ini

# 例外：这些"看起来像产物"的文件是部署真相，必须入库
!apkovl-gz/*.tar.gz
!deploy/*.tar.gz

