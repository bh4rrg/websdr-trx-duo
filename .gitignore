# ============================================================
# websdr-trx-duo 版本管理边界
# 原则：只跟踪"我们自己写/改的东西"（脚本、源码补丁、配置、文档、
# 启动 overlay）。工具链、上游镜像、Vivado/CMake 构建产物、大二进制
# 一律不入库；大二进制用 BIN_MANIFEST.sha256 清单固化身份。
# ============================================================

# ---- 上游/工具链（junction 指向 D:\vendor，绝不入库）----
/fpga/toolchain/
/fpga/sysroot-alpine320/
# kernel_build 现在是真实目录：自研脚本/补丁/defconfig/sdrdma 源码入库，
# 但内部重型上游（内核树、工具链、临时区）是子 junction，构建产物不入库。
/fpga/kernel_build/linux-6.18.38/
/fpga/kernel_build/toolchain/
/fpga/kernel_build/tmp/
/fpga/kernel_build/tmprtl/
/fpga/kernel_build/sdrdma/*.o
/fpga/kernel_build/sdrdma/*.ko
/fpga/kernel_build/sdrdma/*.mod.c
/fpga/kernel_build/sdrdma/*.mod.o
/fpga/kernel_build/sdrdma/*.cmd
/fpga/kernel_build/sdrdma/.*.cmd
/fpga/kernel_build/sdrdma/Module.symvers
/fpga/kernel_build/sdrdma/modules.order
/fpga/kernel_build/sdrdma/Module.markers
/fpga/kernel_build/sdrdma/.tmp_versions/
/fpga/apks/
/fpga/bootimg/
/toolchain/

# ---- 原厂镜像与 SD 卡整盘镜像 ----
*.zip
/sdcard/
/w888/
/trxduo/
/NA/
/src/rpnotes.tar.gz

# ---- boot.bin 及各类大二进制（身份见 BIN_MANIFEST.sha256）----
*.bin
*.bak
bootcap*.bin
deploy/FAT/

# ---- radare2 逆向工具本体（patch/r2 是下载的二进制包）----
/patch/r2/
/patch/*.zip

# ---- Vivado 工程生成物 ----
*.runs/
*.cache/
*.hw/
*.sim/
*.gen/
.ip_user_files/
.Xil/
*.jou
*.log
*.backup.jou
*.backup.log
*.rpx
*.dcp
*.bit
*.ltx
*_vinfo.log
fpga/trxduo_port/out_*/
